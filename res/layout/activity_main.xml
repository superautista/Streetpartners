<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/telaPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#000000"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="S.P. AJUzDA"
        android:textColor="#00FF00"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnSOS"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="🚨 ACIONAR REDE 🚨"
        android:backgroundTint="#FF0000"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnCacador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MODO CAÇADOR (Silencioso)"
        android:backgroundTint="#333333"
        android:textColor="#00FF00"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSusto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MODO SUSTO"
        android:backgroundTint="#550000"
        android:textColor="#FFFFFF" />

</LinearLayout>
