
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STREETPARTNERS"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sua viagem começa aqui!"
            android:textColor="#B0BEC5"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Digite seu destino:"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/editDestino"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Para onde vamos?"
            android:padding="12dp"
            android:backgroundTint="#00C853"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0BEC5"
            android:inputType="textCapSentences"/>

        <Button
            android:id="@+id/btnChamar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="18dp"
            android:text="CHAMAR MOTORISTA"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00C853"/>

        <Button
            android:id="@+id/btnWaze"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="ABRIR ROTA NO WAZE"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0"/>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aguardando conexão..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VALOR DA CORRIDA: R$ 15,50"
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="15dp"/>

        <Button
            android:id="@+id/btnPagar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="PAGAR COM PIX"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00897B"
            android:enabled="false"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="StreetPartners - Mobilidade inteligente"
            android:textColor="#90A4AE"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="25dp"/>

    </LinearLayout>
</ScrollView>
